<main class="container-xxl">
    <div id="organizations-block" class="my-3 p-3 rounded shadow">
        <h6 class="border-bottom pb-2 mb-3">{{t "tpl.admin.orgs.organizations" locale=lang}}</h6>
        <div class="table-responsive-xl small">
            <table id="orgs-table" class="table table-sm table-striped table-hover">
                <thead>
                    <tr>
                        <th class="vw-org-details">{{t "tpl.admin.orgs.organization" locale=lang}}</th>
                        <th class="vw-users">{{t "tpl.admin.orgs.users" locale=lang}}</th>
                        <th class="vw-entries">{{t "tpl.admin.orgs.entries" locale=lang}}</th>
                        <th class="vw-attachments">{{t "tpl.admin.orgs.attachments" locale=lang}}</th>
                        <th class="vw-misc">{{t "tpl.admin.orgs.misc" locale=lang}}</th>
                        <th class="vw-actions text-end">{{t "tpl.admin.orgs.actions" locale=lang}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each page_data}}
                    <tr>
                        <td>
                            <svg width="48" height="48" class="float-start me-2 rounded" data-jdenticon-value="{{id}}">
                            <div class="float-start">
                                <strong>{{name}}</strong>
                                <span class="me-2">({{billingEmail}})</span>
                                <span class="d-block">
                                    <span class="badge bg-success font-monospace">{{id}}</span>
                                </span>
                            </div>
                        </td>
                        <td>
                            <span class="d-block">{{user_count}}</span>
                        </td>
                        <td>
                            <span class="d-block">{{cipher_count}}</span>
                        </td>
                        <td>
                            <span class="d-block"><strong>{{t "tpl.admin.orgs.amount" locale=../lang}}</strong> {{attachment_count}}</span>
                            {{#if attachment_count}}
                            <span class="d-block"><strong>{{t "tpl.admin.orgs.size" locale=../lang}}</strong> {{attachment_size}}</span>
                            {{/if}}
                        </td>
                        <td>
                            <span class="d-block"><strong>{{t "tpl.admin.orgs.collections" locale=../lang}}</strong> {{collection_count}}</span>
                            <span class="d-block"><strong>{{t "tpl.admin.orgs.groups" locale=../lang}}</strong> {{group_count}}</span>
                            <span class="d-block"><strong>{{t "tpl.admin.orgs.events" locale=../lang}}</strong> {{event_count}}</span>
                        </td>
                        <td class="text-end px-1 small">
                            <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-delete-organization data-vw-org-uuid="{{id}}" data-vw-org-name="{{name}}" data-vw-billing-email="{{billingEmail}}">{{t "tpl.admin.orgs.delete_org" locale=../lang}}</button><br>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <div class="mt-3 clearfix">
            <button type="button" class="btn btn-sm btn-primary float-end" id="reload">{{t "tpl.admin.orgs.reload" locale=lang}}</button>
        </div>
    </div>
</main>

<link rel="stylesheet" href="{{urlpath}}/vw_static/datatables.css" />
<script src="{{urlpath}}/vw_static/datatables.js"></script>
<script src="{{urlpath}}/vw_static/admin_organizations.js"></script>
<script src="{{urlpath}}/vw_static/jdenticon-3.3.0.js"></script>
