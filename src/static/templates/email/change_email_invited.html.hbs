      {{t "tpl.email.change_email_invited.body_intro" locale=lang}} ({{ acting_address }}) {{t "tpl.email.change_email_invited.body_intro_mid" locale=lang}} ({{ existing_address }}). {{t "tpl.email.change_email_invited.body_intro_suffix" locale=lang}}
