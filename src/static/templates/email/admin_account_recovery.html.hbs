{{t "tpl.email.admin_account_recovery.subject_prefix" locale=lang}} {{org_name}} {{t "tpl.email.admin_account_recovery.subject_suffix" locale=lang}}
<!---------------->
{{> email/email_header }}
<table width="100%" cellpadding="0" cellspacing="0" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 16px; color: #333; line-height: 25px; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none;">
    <tr style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 16px; color: #333; line-height: 25px; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none;">
        <td class="content-block" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 16px; color: #333; line-height: 25px; margin: 0; -webkit-font-smoothing: antialiased; padding: 0 0 10px; -webkit-text-size-adjust: none;" valign="top">
            {{#if reset_password}}
                {{t "tpl.email.admin_account_recovery.body_reset_password_prefix" locale=lang}} <b style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 16px; color: #333; line-height: 25px; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none;">{{user_name}}</b> {{t "tpl.email.admin_account_recovery.body_reset_password_suffix" locale=lang}}
            {{/if}}
            {{#if reset_2fa}}
                {{t "tpl.email.admin_account_recovery.body_reset_2fa" locale=lang}}{{#if fallback_2fa_email}} {{t "tpl.email.admin_account_recovery.body_fallback_2fa" locale=lang}}{{/if}}
            {{/if}}
            <br>
            {{t "tpl.email.admin_account_recovery.body_ignore" locale=lang}}
        </td>
    </tr>
</table>
{{> email/email_footer }}
